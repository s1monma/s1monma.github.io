# =====================================================================
# Microsoft Graph API & SharePoint Configuration
# =====================================================================
# To enable automated syncing from SharePoint, IT must register an Azure AD
# (Microsoft Entra ID) application with Application permissions.
#
# Once registered, copy this file to `.env` and fill in the values below:
# =====================================================================

# 1. Azure AD App Registration (from Azure Portal > App registrations)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-value-here

# 2. SharePoint Location
# Example Site URL: https://yourtenant.sharepoint.com/sites/YourSiteName
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/AICollective

# Path to the Excel file inside the SharePoint Document Library
# (relative to Document Library root, e.g. "Shared Documents/...")
SHAREPOINT_FILE_PATH=Shared Documents/KS Crypto Collective - Crypto Terms Glossary.xlsx

# Alternatively, if you have a direct SharePoint file sharing link:
# SHAREPOINT_SHARING_URL=https://yourcompany.sharepoint.com/:x:/s/AICollective/Eb123...

# 3. Optional Local Override
# LOCAL_EXCEL_PATH=path/to/local/file.xlsx
